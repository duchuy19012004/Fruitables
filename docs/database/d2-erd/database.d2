# ===== Nhóm 5: Chat & tìm kiếm =====
G5: "Chat & tìm kiếm" {

  PHIEN_CHAT: "Phiên chat (ChatSessions)" {
    shape: sql_table
    "Mã": "GUID" {constraint: primary_key}
    "Mã người dùng": "số nguyên (trống được)" {constraint: foreign_key}
    "Nguồn": "chuỗi (trống được)"
    "Ngày tạo": "ngày giờ"
    "Tin nhắn cuối lúc": "ngày giờ"
  }

  TIN_NHAN_CHAT: "Tin nhắn chat (ChatMessages)" {
    shape: sql_table
    "Mã": "số lớn" {constraint: primary_key}
    "Mã phiên chat": "GUID" {constraint: foreign_key}
    "Vai trò": "Người dùng | Trợ lý"
    "Nội dung": "chuỗi"
    "Dữ liệu phụ (JSON)": "chuỗi (trống được)"
    "Ngày tạo": "ngày giờ"
  }

  HOI_DAP: "Hỏi đáp (Faqs)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Tiêu đề": "chuỗi"
    "Nội dung": "chuỗi"
    "Nhóm": "chuỗi"
    "Đang hoạt động": "đúng/sai"
    "Ngày tạo": "ngày giờ"
    "Ngày cập nhật": "ngày giờ"
  }

  MANG_KIEN_THUC: "Mảng kiến thức (KnowledgeChunks)" {
    shape: sql_table
    "Mã": "số lớn" {constraint: primary_key}
    "Loại nguồn": "Hỏi đáp | Sản phẩm | Cấu hình | Danh mục"
    "Mã nguồn": "chuỗi"
    "Tiêu đề": "chuỗi (trống được)"
    "Nội dung": "chuỗi"
    "Vector embedding (JSON)": "chuỗi"
    "Mã băm nội dung": "chuỗi"
    "Đang hoạt động": "đúng/sai"
    "Ngày cập nhật": "ngày giờ"
  }

  TU_KHOA_HOT: "Từ khóa hot (SearchHotKeywords)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Từ khóa": "chuỗi"
    "Từ khóa chuẩn hóa": "chuỗi"
    "Độ ưu tiên": "số nguyên"
    "Đang hoạt động": "đúng/sai"
    "Ngày tạo": "ngày giờ"
  }
}

# ===== Nhóm 6: Khác =====
G6: "Khác" {

  LIEN_HE: "Liên hệ (ContactMessages)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Tên người gửi": "chuỗi"
    "Email": "chuỗi"
    "Nội dung": "chuỗi"
    "Đã đọc": "đúng/sai"
    "Ngày tạo": "ngày giờ"
  }

  CAU_HINH: "Cấu hình (Settings)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Khóa cấu hình": "chuỗi"
    "Giá trị": "chuỗi (trống được)"
    "Nhóm": "chuỗi (trống được)"
  }
}

# ===== Quan hệ (mức bảng, kèm loại quan hệ) =====
# Người dùng & phân quyền
G1.NGUOI_DUNG -> G1.DIA_CHI: "1-N: có địa chỉ"
G1.NGUOI_DUNG -> G1.NGUOI_DUNG_VAI_TRO: "1-N: được gán vai trò"
G1.VAI_TRO -> G1.NGUOI_DUNG_VAI_TRO: "1-N: gán cho người dùng"
G1.VAI_TRO -> G1.VAI_TRO_QUYEN: "1-N: có quyền"
G1.QUYEN -> G1.VAI_TRO_QUYEN: "1-N: thuộc vai trò"
G1.NGUOI_DUNG -> G1.NHAT_KY_TAI_KHOAN: "1-N: có nhật ký"
G1.NGUOI_DUNG -> G1.NHAT_KY_PHAN_QUYEN: "1-N: admin thay đổi"

# Sản phẩm
G2.DANH_MUC -> G2.DANH_MUC: "1-N: cha – con"
G2.DANH_MUC -> G2.SAN_PHAM: "1-N: chứa sản phẩm"
G2.SAN_PHAM -> G2.ANH_SAN_PHAM: "1-N: có ảnh"
G2.SAN_PHAM -> G2.SAN_PHAM_THE: "N-N: gắn thẻ"
G2.THE -> G2.SAN_PHAM_THE: "N-N: gắn vào sản phẩm"
G2.SAN_PHAM -> G2.PHAN_LOAI: "1-N: có phân loại"
G2.SAN_PHAM -> G2.LICH_GIAM_GIA: "1-N: có lịch giảm giá"
G2.PHAN_LOAI -> G2.LICH_GIAM_GIA: "1-N: áp lịch cho"
G2.SAN_PHAM -> G2.NHAT_KY_SAN_PHAM: "1-N: có nhật ký"
G1.NGUOI_DUNG -> G2.LICH_GIAM_GIA: "1-N: admin tạo lịch"
G1.NGUOI_DUNG -> G2.NHAT_KY_SAN_PHAM: "1-N: admin ghi log"

# Giỏ hàng & đơn hàng
G3.GIO_HANG -> G3.MUC_GIO_HANG: "1-N: chứa mục"
G1.NGUOI_DUNG -> G3.GIO_HANG: "1-1: sở hữu giỏ"
G2.SAN_PHAM -> G3.MUC_GIO_HANG: "1-N: nằm trong giỏ"
G2.PHAN_LOAI -> G3.MUC_GIO_HANG: "1-N: được chọn"
G1.NGUOI_DUNG -> G3.DON_HANG: "1-N: đặt đơn"
G1.DIA_CHI -> G3.DON_HANG: "1-N: giao tới"
G3.DON_HANG -> G3.MUC_DON_HANG: "1-N: gồm mục"
G2.SAN_PHAM -> G3.MUC_DON_HANG: "1-N: được bán"
G2.PHAN_LOAI -> G3.MUC_DON_HANG: "1-N: bán theo"
G3.DON_HANG -> G3.LICH_SU_DON: "1-N: có lịch sử"
G1.NGUOI_DUNG -> G3.LICH_SU_DON: "1-N: admin đổi trạng thái"
G3.DON_HANG -> G3.GHI_CHU_DON: "1-N: có ghi chú"
G3.DON_HANG -> G3.GIAO_DICH_SEPAY: "1-N: thanh toán qua"

# Đánh giá & yêu thích
G2.SAN_PHAM -> G4.DANH_GIA: "1-N: nhận đánh giá"
G1.NGUOI_DUNG -> G4.DANH_GIA: "1-N: viết đánh giá"
G4.DANH_GIA -> G4.BAO_CAO_DANH_GIA: "1-N: bị báo cáo"
G1.NGUOI_DUNG -> G4.BAO_CAO_DANH_GIA: "1-N: báo cáo / xử lý"
G4.DANH_GIA -> G4.DANH_GIA_HUU_ICH: "1-N: được vote"
G1.NGUOI_DUNG -> G4.DANH_GIA_HUU_ICH: "1-N: vote hữu ích"
G1.NGUOI_DUNG -> G4.YEU_THICH: "1-N: thích sản phẩm"
G2.SAN_PHAM -> G4.YEU_THICH: "1-N: được yêu thích"
G1.NGUOI_DUNG -> G4.CAM_NHAN_KHACH: "1-N: gửi cảm nhận"

# Chat & tìm kiếm
G1.NGUOI_DUNG -> G5.PHIEN_CHAT: "1-N: có phiên chat"
G5.PHIEN_CHAT -> G5.TIN_NHAN_CHAT: "1-N: chứa tin nhắn"
