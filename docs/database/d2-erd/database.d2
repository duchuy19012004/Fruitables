    "Đơn giá": "số thập phân"
  }

  DON_HANG: "Đơn hàng (Orders)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Mã khách": "số nguyên (trống được)" {constraint: foreign_key}
    "Mã địa chỉ giao": "số nguyên (trống được)" {constraint: foreign_key}
    "Thông tin giao hàng (chụp)": "chuỗi (trống được)"
    "Mã đơn hàng": "chuỗi"
    "Trạng thái đơn": "Chờ xử lý | Đang xử lý | Đang giao | Đã giao | Đã hủy | Đã trả"
    "Tạm tính": "số thập phân"
    "Phí vận chuyển": "số thập phân"
    "Giảm giá": "số thập phân"
    "Tổng cộng": "số thập phân"
    "Hình thức thanh toán": "Chuyển khoản | Séc | COD | Paypal"
    "Trạng thái thanh toán": "Chờ thanh toán | Đã thanh toán | Đã hoàn tiền"
    "Mã thanh toán": "chuỗi (trống được)"
    "Hình thức giao hàng": "Miễn phí | Đồng giá | Nhận tại cửa hàng"
    "Ghi chú": "chuỗi (trống được)"
    "Lý do hủy": "chuỗi (trống được)"
    "Ngày đặt": "ngày giờ"
    "Phiên bản dòng (chống xung đột)": "mảng byte (trống được)"
  }

  MUC_DON_HANG: "Mục đơn hàng (OrderItems)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Mã đơn hàng": "số nguyên" {constraint: foreign_key}
    "Mã sản phẩm": "số nguyên" {constraint: foreign_key}
    "Mã phân loại": "số nguyên (trống được)" {constraint: foreign_key}
    "Tên phân loại": "chuỗi (trống được)"
    "SKU phân loại": "chuỗi (trống được)"
    "Tên sản phẩm": "chuỗi"
    "Số lượng": "số nguyên"
    "Đơn giá": "số thập phân"
    "Thành tiền": "số thập phân"
  }

  GIAO_DICH_SEPAY: "Giao dịch SePay (SePayTransactions)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Mã giao dịch SePay": "số lớn"
    "Mã đơn hàng": "số nguyên (trống được)" {constraint: foreign_key}
    "Mã thanh toán": "chuỗi (trống được)"
    "Số tiền chuyển": "số thập phân"
    "Mã tham chiếu": "chuỗi (trống được)"
    "Trạng thái": "Đã thanh toán | Trùng | Bỏ qua"
    "Thông điệp": "chuỗi (trống được)"
    "Dữ liệu gốc": "chuỗi"
    "Ngày tạo": "ngày giờ"
  }

  LICH_SU_DON: "Lịch sử trạng thái đơn (OrderStatusHistories)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Mã đơn hàng": "số nguyên" {constraint: foreign_key}
    "Trạng thái cũ": "như Trạng thái đơn"
    "Trạng thái mới": "như Trạng thái đơn"
    "Mã admin đổi": "số nguyên" {constraint: foreign_key}
    "Ghi chú": "chuỗi (trống được)"
    "Ngày tạo": "ngày giờ"
  }

  GHI_CHU_DON: "Ghi chú đơn (OrderNotes)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Mã đơn hàng": "số nguyên" {constraint: foreign_key}
    "Mã admin": "số nguyên"
    "Tên admin": "chuỗi"
    "Nội dung": "chuỗi"
    "Ngày tạo": "ngày giờ"
  }

  MA_GIAM_GIA: "Mã giảm giá (Coupons)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Mã coupon": "chuỗi"
    "Kiểu giảm": "Phần trăm | Số tiền cố định"
    "Giá trị": "số thập phân"
    "Đơn tối thiểu": "số thập phân"
    "Số lượng tối thiểu": "số nguyên"
    "Lượt dùng tối đa": "số nguyên (trống được)"
    "Đã dùng": "số nguyên"
    "Ngày bắt đầu": "ngày giờ (trống được)"
    "Ngày kết thúc": "ngày giờ (trống được)"
    "Đang hoạt động": "đúng/sai"
  }
}

