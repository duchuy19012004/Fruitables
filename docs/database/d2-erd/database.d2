direction: right

# Tăng khoảng cách node/cạnh để mũi tên không đè bảng
elk.spacing.nodeNode: 70
elk.layered.spacing.nodeNodeBetweenLayers: 90
elk.spacing.edgeNode: 30
elk.spacing.edgeEdge: 20

# ===== Nhóm 1: Người dùng & phân quyền =====
G1: "Người dùng & phân quyền" {

  VAI_TRO: "Vai trò (Roles)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Tên vai trò": "chuỗi"
    "Mô tả": "chuỗi (trống được)"
    "Đang hoạt động": "đúng/sai"
    "Ngày tạo": "ngày giờ"
    "Ngày cập nhật": "ngày giờ"
  }

  QUYEN: "Quyền (Permissions)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Tên quyền": "chuỗi"
    "Mô tả": "chuỗi (trống được)"
    "Nhóm chức năng": "chuỗi"
    "Ngày tạo": "ngày giờ"
  }

  NGUOI_DUNG_VAI_TRO: "Người dùng – Vai trò (UserRoleMappings)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Mã người dùng": "số nguyên" {constraint: foreign_key}
    "Mã vai trò": "số nguyên" {constraint: foreign_key}
    "Gán lúc": "ngày giờ"
    "Gán bởi Admin": "số nguyên (trống được)" {constraint: foreign_key}
  }

  VAI_TRO_QUYEN: "Vai trò – Quyền (RolePermissions)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Mã vai trò": "số nguyên" {constraint: foreign_key}
    "Mã quyền": "số nguyên" {constraint: foreign_key}
    "Gán lúc": "ngày giờ"
    "Gán bởi Admin": "số nguyên (trống được)" {constraint: foreign_key}
  }

  NGUOI_DUNG: "Người dùng (Users)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Họ tên": "chuỗi"
    "Email": "chuỗi"
    "Mật khẩu (đã mã hóa)": "chuỗi"
    "Số điện thoại": "chuỗi (trống được)"
    "Ảnh đại diện": "chuỗi (trống được)"
    "Vai trò": "Khách | Admin | SuperAdmin"
    "Đang hoạt động": "đúng/sai"
    "Đăng nhập lần cuối": "ngày giờ (trống được)"
    "Mã Google": "chuỗi (trống được)"
    "Mã đặt lại mật khẩu": "chuỗi (trống được)"
    "Hạn mã đặt lại MK": "ngày giờ (trống được)"
    "Kiểu khóa hiện tại": "Tạm thời | Vĩnh viễn (trống được)"
    "Lý do khóa": "chuỗi (trống được)"
    "Loại vi phạm": "chuỗi (trống được)"
    "Thời điểm khóa": "ngày giờ (trống được)"
    "Hết hạn khóa": "ngày giờ (trống được)"
    "Bị khóa bởi Admin": "số nguyên (trống được)" {constraint: foreign_key}
    "Ngày tạo": "ngày giờ"
    "Ngày cập nhật": "ngày giờ"
  }

  DIA_CHI: "Địa chỉ (Addresses)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Mã người dùng": "số nguyên (trống được)" {constraint: foreign_key}
    "Họ tên người nhận": "chuỗi"
    "Số điện thoại": "chuỗi"
    "Mã tỉnh/thành": "chuỗi"
    "Tên tỉnh/thành": "chuỗi"
    "Mã xã/phường": "chuỗi"
    "Tên xã/phường": "chuỗi"
    "Mã quận GHN": "số nguyên (trống được)"
    "Mã phường GHN": "chuỗi (trống được)"
    "Địa chỉ chi tiết": "chuỗi"
    "Là mặc định": "đúng/sai"
    "Ngày tạo": "ngày giờ"
    "Ngày cập nhật": "ngày giờ (trống được)"
  }

  NHAT_KY_TAI_KHOAN: "Nhật ký tài khoản (UserAccountLogs)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Mã người dùng": "số nguyên" {constraint: foreign_key}
    "Mã admin thực hiện": "số nguyên" {constraint: foreign_key}
    "Hành động": "chuỗi"
    "Kiểu khóa": "Tạm thời | Vĩnh viễn (trống được)"
    "Loại vi phạm": "chuỗi (trống được)"
    "Lý do": "chuỗi (trống được)"
    "Hết hạn": "ngày giờ (trống được)"
    "Địa chỉ IP": "chuỗi (trống được)"
    "Trình duyệt": "chuỗi (trống được)"
    "Ngày tạo": "ngày giờ"
  }

  NHAT_KY_PHAN_QUYEN: "Nhật ký phân quyền (RbacAuditLogs)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Hành động": "chuỗi"
    "Loại đối tượng": "chuỗi"
    "Mã đối tượng": "số nguyên"
    "Đổi bởi Admin": "số nguyên" {constraint: foreign_key}
    "Thời điểm đổi": "ngày giờ"
    "Giá trị cũ": "chuỗi (trống được)"
    "Giá trị mới": "chuỗi (trống được)"
  }
}

# ===== Nhóm 2: Sản phẩm =====
G2: "Sản phẩm" {

  DANH_MUC: "Danh mục (Categories)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Tên danh mục": "chuỗi"
    "Đường dẫn (slug)": "chuỗi"
    "Mô tả": "chuỗi (trống được)"
    "Ảnh": "chuỗi (trống được)"
    "Danh mục cha": "số nguyên (trống được)" {constraint: foreign_key}
    "Thứ tự sắp xếp": "số nguyên"
    "Đang hoạt động": "đúng/sai"
    "Đã xóa": "đúng/sai"
    "Ngày xóa": "ngày giờ (trống được)"
    "Ngày tạo": "ngày giờ"
    "Ngày cập nhật": "ngày giờ"
  }

  ANH_SAN_PHAM: "Ảnh sản phẩm (ProductImages)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Mã sản phẩm": "số nguyên" {constraint: foreign_key}
    "Đường dẫn ảnh": "chuỗi"
    "Là ảnh chính": "đúng/sai"
    "Thứ tự": "số nguyên"
  }

  SAN_PHAM: "Sản phẩm (Products)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Mã danh mục": "số nguyên" {constraint: foreign_key}
    "Tên sản phẩm": "chuỗi"
    "Đường dẫn (slug)": "chuỗi"
    "Mô tả chi tiết": "chuỗi (trống được)"
    "Mô tả ngắn": "chuỗi (trống được)"
    "Giá gốc": "số thập phân"
    "Đơn vị tính": "chuỗi"
    "Khối lượng": "số thập phân (trống được)"
    "Xuất xứ": "chuỗi (trống được)"
    "Chất lượng": "chuỗi (trống được)"
    "Tồn kho": "số nguyên"
    "Số lượng đặt tối thiểu": "số nguyên"
    "Nổi bật": "đúng/sai"
    "Đang hoạt động": "đúng/sai"
    "Đã xóa": "đúng/sai"
    "Ngày xóa": "ngày giờ (trống được)"
    "Điểm đánh giá TB": "số thập phân"
    "Số lượt đánh giá": "số nguyên"
    "Ngày tạo": "ngày giờ"
    "Ngày cập nhật": "ngày giờ"
  }

  PHAN_LOAI: "Phân loại (ProductVariants)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Mã sản phẩm": "số nguyên" {constraint: foreign_key}
    "Mã SKU": "chuỗi"
    "Tên phân loại": "chuỗi"
    "Giá": "số thập phân"
    "Tồn kho": "số nguyên"
    "Đang hoạt động": "đúng/sai"
    "Ngày tạo": "ngày giờ"
  }

  LICH_GIAM_GIA: "Lịch giảm giá (PriceSchedules)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Mã sản phẩm": "số nguyên" {constraint: foreign_key}
    "Mã phân loại": "số nguyên (trống được)" {constraint: foreign_key}
    "Kiểu giảm": "Giá cố định | Phần trăm"
    "Giá trị giảm": "số thập phân"
    "Bắt đầu": "ngày giờ"
    "Kết thúc": "ngày giờ (trống được)"
    "Đã hủy": "đúng/sai"
    "Tạo bởi Admin": "số nguyên (trống được)" {constraint: foreign_key}
    "Ngày tạo": "ngày giờ"
    "Ngày cập nhật": "ngày giờ"
  }

  SAN_PHAM_THE: "Sản phẩm – Thẻ (ProductTagMapping)" {
    shape: sql_table
    "Mã sản phẩm": "số nguyên" {constraint: foreign_key}
    "Mã thẻ": "số nguyên" {constraint: foreign_key}
  }

  THE: "Thẻ (ProductTags)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Tên thẻ": "chuỗi"
    "Đường dẫn (slug)": "chuỗi"
  }

  NHAT_KY_SAN_PHAM: "Nhật ký sản phẩm (ProductLogs)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Mã sản phẩm": "số nguyên (trống được)" {constraint: foreign_key}
    "Mã admin": "số nguyên" {constraint: foreign_key}
    "Hành động": "chuỗi"
    "Chi tiết": "chuỗi (trống được)"
    "Ngày tạo": "ngày giờ"
  }
}

# ===== Nhóm 3: Giỏ hàng & đơn hàng =====
G3: "Giỏ hàng & đơn hàng" {

  GIO_HANG: "Giỏ hàng (Carts)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Mã người dùng": "số nguyên (trống được)" {constraint: foreign_key}
    "Mã phiên khách": "chuỗi (trống được)"
    "Mã giảm giá": "chuỗi (trống được)"
    "Số tiền giảm": "số thập phân"
    "Ngày tạo": "ngày giờ"
    "Ngày cập nhật": "ngày giờ"
  }

  MUC_GIO_HANG: "Mục giỏ hàng (CartItems)" {
    shape: sql_table
    "Mã": "số nguyên" {constraint: primary_key}
    "Mã giỏ hàng": "số nguyên" {constraint: foreign_key}
    "Mã sản phẩm": "số nguyên" {constraint: foreign_key}
    "Mã phân loại": "số nguyên (trống được)" {constraint: foreign_key}
