direction: right

# ERD phạm vi chức năng Chatbox (chat AI hỗ trợ khách hàng)

NGUOI_DUNG: "Người dùng (Users — các cột chính)" {
  shape: sql_table
  "Mã": "số nguyên" {constraint: primary_key}
  "Họ tên": "chuỗi"
  "Email": "chuỗi"
  "Vai trò": "Khách | Admin | SuperAdmin"
  "Đang hoạt động": "đúng/sai"
  "Ngày tạo": "ngày giờ"
}

PHIEN_CHAT: "Phiên chat (ChatSessions)" {
  shape: sql_table
  "Mã": "GUID" {constraint: primary_key}
  "Mã người dùng": "số nguyên (trống được)" {constraint: foreign_key}
  "Nguồn": "chuỗi (trống được)"
  "Ngày tạo": "ngày giờ"
  "Tin nhắn cuối lúc": "ngày giờ"
}

TIN_NHAN_CHAT: "Tin nhắn chat (ChatMessages)" {
  shape: sql_table
  "Mã": "số lớn" {constraint: primary_key}
  "Mã phiên chat": "GUID" {constraint: foreign_key}
  "Vai trò": "Người dùng | Trợ lý"
  "Nội dung": "chuỗi"
  "Dữ liệu phụ (JSON)": "chuỗi (trống được)"
  "Ngày tạo": "ngày giờ"
}

MANG_KIEN_THUC: "Mảng kiến thức (KnowledgeChunks)" {
  shape: sql_table
  "Mã": "số lớn" {constraint: primary_key}
  "Loại nguồn": "Hỏi đáp | Sản phẩm | Cấu hình | Danh mục"
  "Mã nguồn": "chuỗi"
  "Tiêu đề": "chuỗi (trống được)"
  "Nội dung": "chuỗi"
  "Vector embedding (JSON)": "chuỗi"
  "Mã băm nội dung": "chuỗi"
  "Đang hoạt động": "đúng/sai"
  "Ngày cập nhật": "ngày giờ"
}

HOI_DAP: "Hỏi đáp (Faqs)" {
  shape: sql_table
  "Mã": "số nguyên" {constraint: primary_key}
  "Tiêu đề": "chuỗi"
  "Nội dung": "chuỗi"
  "Nhóm": "chuỗi"
  "Đang hoạt động": "đúng/sai"
  "Ngày tạo": "ngày giờ"
  "Ngày cập nhật": "ngày giờ"
}

SAN_PHAM: "Sản phẩm (Products — các cột chính)" {
  shape: sql_table
  "Mã": "số nguyên" {constraint: primary_key}
  "Mã danh mục": "số nguyên" {constraint: foreign_key}
  "Tên sản phẩm": "chuỗi"
  "Giá gốc": "số thập phân"
  "Tồn kho": "số nguyên"
  "Đang hoạt động": "đúng/sai"
  "Đã xóa": "đúng/sai"
}

# ===== Quan hệ =====
NGUOI_DUNG -> PHIEN_CHAT: "1-N: có phiên chat"
PHIEN_CHAT -> TIN_NHAN_CHAT: "1-N: chứa tin nhắn"

# Tham chiếu mềm (Mã nguồn trỏ tới bảng gốc, không phải khóa ngoại thật)
HOI_DAP -> MANG_KIEN_THUC: "1-N: nạp vào tri thức (tham chiếu mềm)" {
  style.stroke-dash: 4
}
SAN_PHAM -> MANG_KIEN_THUC: "1-N: nạp vào tri thức (tham chiếu mềm)" {
  style.stroke-dash: 4
}
