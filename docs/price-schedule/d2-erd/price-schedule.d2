direction: right

# ERD phạm vi chức năng Quản lý giá (giá gốc + lịch giảm giá)

DANH_MUC: "Danh mục (Categories — các cột chính)" {
  shape: sql_table
  "Mã": "số nguyên" {constraint: primary_key}
  "Tên danh mục": "chuỗi"
  "Danh mục cha": "số nguyên (trống được)" {constraint: foreign_key}
  "Đang hoạt động": "đúng/sai"
  "Đã xóa": "đúng/sai"
}

SAN_PHAM: "Sản phẩm (Products)" {
  shape: sql_table
  "Mã": "số nguyên" {constraint: primary_key}
  "Mã danh mục": "số nguyên" {constraint: foreign_key}
  "Tên sản phẩm": "chuỗi"
  "Đường dẫn (slug)": "chuỗi"
  "Giá gốc": "số thập phân"
  "PriceRevision": "số nguyên — concurrency token"
  "Đơn vị tính": "chuỗi"
  "Tồn kho": "số nguyên"
  "Số lượng đặt tối thiểu": "số nguyên"
  "Nổi bật": "đúng/sai"
  "Đang hoạt động": "đúng/sai"
  "Đã xóa": "đúng/sai"
  "Ngày xóa": "ngày giờ (trống được)"
  "Ngày tạo": "ngày giờ"
  "Ngày cập nhật": "ngày giờ"
}

PHAN_LOAI: "Phân loại (ProductVariants)" {
  shape: sql_table
  "Mã": "số nguyên" {constraint: primary_key}
  "Mã sản phẩm": "số nguyên" {constraint: foreign_key}
  "Mã SKU": "chuỗi"
  "Tên phân loại": "chuỗi"
  "Giá": "số thập phân"
  "PriceRevision": "số nguyên — concurrency token"
  "Tồn kho": "số nguyên"
  "Đang hoạt động": "đúng/sai"
  "Ngày tạo": "ngày giờ"
}

LICH_GIAM_GIA: "Lịch giảm giá (PriceSchedules)" {
  shape: sql_table
  "Mã": "số nguyên" {constraint: primary_key}
  "Mã sản phẩm": "số nguyên" {constraint: foreign_key}
  "Mã phân loại": "số nguyên (trống được)" {constraint: foreign_key}
  "Kiểu giảm": "Giá cố định | Phần trăm"
  "Giá trị giảm": "số thập phân"
  "Bắt đầu": "ngày giờ"
  "Kết thúc": "ngày giờ (trống được)"
  "Đã hủy": "đúng/sai"
  "CancelledAt": "ngày giờ (trống được)"
  "CancelledByAdminId": "số nguyên (trống được)" {constraint: foreign_key}
  "CancellationReason": "chuỗi 500 (trống được)"
  "Revision": "số nguyên — concurrency token"
  "Tạo bởi Admin": "số nguyên (trống được)" {constraint: foreign_key}
  "Ngày tạo": "ngày giờ"
  "Ngày cập nhật": "ngày giờ"
}

NHAT_KY_SAN_PHAM: "Nhật ký sản phẩm (ProductLogs)" {
  shape: sql_table
  "Mã": "số nguyên" {constraint: primary_key}
  "Mã sản phẩm": "số nguyên (trống được)" {constraint: foreign_key}
  "Mã admin": "số nguyên" {constraint: foreign_key}
  "Hành động": "chuỗi"
  "Chi tiết": "chuỗi (trống được)"
  "Ngày tạo": "ngày giờ"
}

NGUOI_DUNG: "Người dùng (Users — các cột chính)" {
  shape: sql_table
  "Mã": "số nguyên" {constraint: primary_key}
  "Họ tên": "chuỗi"
  "Email": "chuỗi"
  "Vai trò": "Khách | Admin | SuperAdmin"
  "Đang hoạt động": "đúng/sai"
}

# ===== Quan hệ =====
DANH_MUC -> SAN_PHAM: "1-N: chứa sản phẩm"
SAN_PHAM -> PHAN_LOAI: "1-N: có phân loại"
SAN_PHAM -> LICH_GIAM_GIA: "1-N: có lịch giảm giá"
PHAN_LOAI -> LICH_GIAM_GIA: "1-N: áp lịch cho"
NGUOI_DUNG -> LICH_GIAM_GIA: "1-N: admin tạo lịch"
NGUOI_DUNG -> LICH_GIAM_GIA: "1-N: admin hủy lịch (SET NULL)"
SAN_PHAM -> NHAT_KY_SAN_PHAM: "1-N: có nhật ký giá"
NGUOI_DUNG -> NHAT_KY_SAN_PHAM: "1-N: admin ghi nhật ký"
