@using Fruitables.Models
@using Fruitables.ViewModels
@model ShopViewModel

@if (Model.Products.Any())
{
    @foreach (var product in Model.Products)
    {
        var primaryImage = product.Images?.FirstOrDefault(i => i.IsPrimary)?.ImageUrl
            ?? product.Images?.FirstOrDefault()?.ImageUrl
            ?? "~/img/fruite-item-5.jpg";
        var activeVariants = product.Variants.Where(v => v.IsActive).ToList();
        var hasVariants = activeVariants.Count > 0;
        var availableVariantCount = activeVariants.Count(v => v.StockQuantity >= product.MinOrderQuantity);
        var isAvailable = hasVariants
            ? availableVariantCount > 0
            : product.StockQuantity >= product.MinOrderQuantity;
        var isLowStock = !hasVariants && isAvailable && product.StockQuantity <= 5;
        var isSale = !hasVariants && product.Price > 0 && product.DisplayMinPrice < product.Price;
        var displayPrice = product.DisplayMinPrice;
        var discountPercent = isSale ? (int)Math.Round((1 - product.DisplayMinPrice / product.Price) * 100) : 0;
        var rawDescription = !string.IsNullOrWhiteSpace(product.ShortDescription)
            ? product.ShortDescription
            : product.Description;
        var description = !string.IsNullOrWhiteSpace(rawDescription) && rawDescription.Length > 90
            ? rawDescription.Substring(0, 87).TrimEnd() + "…"
            : rawDescription;

        <article class="shop-product-card @(!isAvailable ? "is-unavailable" : null)">
            <a asp-controller="Shop" asp-action="Detail" asp-route-slug="@product.Slug" class="shop-product-image" aria-label="Xem @product.Name">
                <img src="@primaryImage" alt="@product.Name" loading="lazy" decoding="async">
                <div class="shop-product-badges" aria-hidden="true">
                    @if (isSale)
                    {
                        <span class="shop-sale-badge">Giảm @discountPercent%</span>
                    }
                    @if (!isAvailable)
                    {
                        <span class="shop-stock-badge is-out">Hết hàng</span>
                    }
                    else if (isLowStock)
                    {
                        <span class="shop-stock-badge">Còn @product.StockQuantity</span>
                    }
                </div>
                <span class="shop-image-action">Xem sản phẩm <i class="fas fa-arrow-right"></i></span>
            </a>

            <div class="shop-product-body">
                <div class="shop-product-overline">
                    <span>@(product.Category?.Name ?? "Nông sản")</span>
                    @if (product.ReviewCount > 0)
                    {
                        <span class="shop-rating" aria-label="@product.AverageRating.ToString("0.0") trên 5 sao, @product.ReviewCount đánh giá">
                            <i class="fas fa-star" aria-hidden="true"></i>
                            @product.AverageRating.ToString("0.0") <small>(@product.ReviewCount)</small>
                        </span>
                    }
                </div>

                <a asp-controller="Shop" asp-action="Detail" asp-route-slug="@product.Slug" class="shop-product-name">@product.Name</a>

                <div class="shop-product-facts">
                    @if (!string.IsNullOrWhiteSpace(product.CountryOrigin))
                    {
                        <span><i class="fas fa-map-marker-alt" aria-hidden="true"></i>@product.CountryOrigin</span>
                    }
                    @if (hasVariants)
                    {
                        <span><i class="fas fa-layer-group" aria-hidden="true"></i>@availableVariantCount lựa chọn</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(description))
                {
                    <p class="shop-product-description">@description</p>
                }

                <div class="shop-product-purchase">
                    <div class="shop-price">
                        <span class="shop-price-label">Giá bán</span>
                        <div>
                            <strong>
                                @if (hasVariants && product.DisplayMaxPrice != product.DisplayMinPrice)
                                {
                                    @:@product.DisplayMinPrice.ToString("N0")–@product.DisplayMaxPrice.ToString("N0")đ
                                }
                                else
                                {
                                    @:@displayPrice.ToString("N0")đ
                                }
                            </strong>
                            <small>/ @product.Unit</small>
                        </div>
                        @if (isSale)
                        {
                            <del>@product.Price.ToString("N0")đ</del>
                        }
                    </div>

                    @if (hasVariants)
                    {
                        <a asp-controller="Shop" asp-action="Detail" asp-route-slug="@product.Slug"
                           class="shop-product-cta @(!isAvailable ? "is-disabled" : null)"
                           aria-disabled="@(!isAvailable)" tabindex="@(!isAvailable ? -1 : 0)">
                            <span>@(isAvailable ? "Chọn loại" : "Tạm hết hàng")</span>
                            <i class="fas fa-arrow-right" aria-hidden="true"></i>
                        </a>
                    }
                    else
                    {
                        <form asp-controller="Cart" asp-action="AddToCart" method="post">
                            <input type="hidden" name="productId" value="@product.Id" />
                            <input type="hidden" name="quantity" value="@product.MinOrderQuantity" />
                            <button type="submit" class="shop-product-cta" disabled="@(!isAvailable)" aria-label="@(isAvailable ? $"Thêm {product.Name} vào giỏ hàng" : $"{product.Name} hiện hết hàng")">
                                <i class="fas fa-shopping-basket" aria-hidden="true"></i>
                                <span>@(isAvailable ? "Thêm vào giỏ" : "Tạm hết hàng")</span>
                            </button>
                        </form>
                    }
                </div>
            </div>
        </article>
    }

    @if (Model.TotalPages > 1)
    {
        var startPage = Math.Max(1, Model.CurrentPage - 2);
        var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
        <nav class="shop-pagination" aria-label="Phân trang sản phẩm">
            <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-search="@Model.SearchTerm" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-sortBy="@Model.SortBy" asp-route-page="@(Model.CurrentPage - 1)" class="shop-page-arrow @(Model.CurrentPage == 1 ? "is-disabled" : null)" aria-disabled="@(Model.CurrentPage == 1)" tabindex="@(Model.CurrentPage == 1 ? -1 : 0)" aria-label="Trang trước">
                <i class="fas fa-chevron-left" aria-hidden="true"></i>
            </a>
            @if (startPage > 1)
            {
                <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-search="@Model.SearchTerm" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-sortBy="@Model.SortBy" asp-route-page="1">1</a>
                @if (startPage > 2) { <span class="shop-page-gap">…</span> }
            }
            @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
            {
                <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-search="@Model.SearchTerm" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-sortBy="@Model.SortBy" asp-route-page="@pageNumber" class="@(pageNumber == Model.CurrentPage ? "active" : null)" aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">@pageNumber</a>
            }
            @if (endPage < Model.TotalPages)
            {
                @if (endPage < Model.TotalPages - 1) { <span class="shop-page-gap">…</span> }
                <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-search="@Model.SearchTerm" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-sortBy="@Model.SortBy" asp-route-page="@Model.TotalPages">@Model.TotalPages</a>
            }
            <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-search="@Model.SearchTerm" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-sortBy="@Model.SortBy" asp-route-page="@(Model.CurrentPage + 1)" class="shop-page-arrow @(Model.CurrentPage == Model.TotalPages ? "is-disabled" : null)" aria-disabled="@(Model.CurrentPage == Model.TotalPages)" tabindex="@(Model.CurrentPage == Model.TotalPages ? -1 : 0)" aria-label="Trang tiếp theo">
                <i class="fas fa-chevron-right" aria-hidden="true"></i>
            </a>
        </nav>
    }
}
else
{
    <div class="shop-empty-state">
        <i class="fas fa-search" aria-hidden="true"></i>
        <h2>Không tìm thấy sản phẩm</h2>
        <p>Hãy thử đổi từ khóa, danh mục hoặc mức giá để xem thêm sản phẩm phù hợp.</p>
        <a asp-controller="Shop" asp-action="Index" class="btn btn-primary">Xem tất cả sản phẩm</a>
    </div>
}
