<div class="modal fade" id="searchModal" tabindex="-1" aria-labelledby="searchModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content rounded-0">
            <div class="modal-header">
                <h2 class="modal-title h5" id="searchModalTitle">Tìm kiếm sản phẩm</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body d-flex align-items-center">
                <form asp-controller="Shop" asp-action="Index" method="get" class="input-group w-75 mx-auto d-flex" role="search">
                    <label class="visually-hidden" for="globalProductSearch">Tên sản phẩm cần tìm</label>
                    <input id="globalProductSearch" type="search" name="search" data-search-suggest class="form-control p-3" placeholder="Nhập tên sản phẩm..." autocomplete="off">
                    <button type="submit" class="input-group-text p-3" aria-label="Tìm kiếm sản phẩm"><i class="fa fa-search" aria-hidden="true"></i></button>
                </form>
            </div>
        </div>
    </div>
</div>
