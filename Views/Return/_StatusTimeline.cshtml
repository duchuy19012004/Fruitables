@using Fruitables.Helpers
@using Fruitables.Models.Returns
@model IEnumerable<ReturnEvent>
<ol class="list-group list-group-numbered">
@foreach (var item in Model.OrderBy(x => x.CreatedAtUtc))
{
    var entry = ReturnDisplay.CustomerTimelineEvent(item);
    if (entry == null) { continue; }
    <li class="list-group-item">
        <div class="d-flex justify-content-between gap-3"><strong>@entry.Value.Title</strong><small class="text-muted">@item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></div>
        @if (!string.IsNullOrWhiteSpace(entry.Value.Note)) { <span>@entry.Value.Note</span> }
    </li>
}
</ol>
