@model Fruitables.ViewModels.Returns.ReturnEligibilityViewModel
@{
    ViewData["Title"] = "Gửi khiếu nại hoàn tiền";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="mb-2">Khiếu nại đơn @Model.OrderNumber</h2>
                    <p class="text-muted">Chỉ gửi khiếu nại cho phần hàng có vấn đề. Thời hạn: @Model.ClaimDeadlineAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm").</p>
                    <div class="alert alert-warning">Ảnh xác minh bắt buộc với hàng hư/dập, mốc hoặc không tươi. Giao sai/giao thiếu cần mô tả rõ.</div>

                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="OrderId" value="@Model.OrderId" />
                        @for (var index = 0; index < Model.Items.Count; index++)
                        {
                            var item = Model.Items[index];
                            <div class="border rounded p-3 mb-3">
                                <input type="hidden" name="Items[@index].OrderItemId" value="@item.OrderItemId" />
                                <h5>@item.ProductName <small class="text-muted">(@item.OrderedQuantity @item.Unit)</small></h5>
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label class="form-label">Số lượng khiếu nại</label>
                                        <input name="Items[@index].RequestedQuantity" type="number" min="0" max="@item.MaxClaimableQuantity" step="@(item.Unit.Equals("kg", StringComparison.OrdinalIgnoreCase) ? "0.1" : "1")" value="0" class="form-control" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Lý do</label>
                                        <select name="Items[@index].Reason" class="form-select">
                                            <option value="Damaged">Hư/dập</option>
                                            <option value="Mold">Mốc</option>
                                            <option value="NotFresh">Không tươi</option>
                                            <option value="WrongItem">Giao sai</option>
                                            <option value="MissingItem">Giao thiếu</option>
                                        </select>
                                    </div>
                                    <div class="col-md-5">
                                        <label class="form-label">Ảnh xác minh</label>
                                        <input name="Items[@index].Evidence" type="file" accept="image/*" multiple class="form-control" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Mô tả</label>
                                        <textarea name="Items[@index].Description" rows="2" class="form-control" placeholder="Mô tả tình trạng sản phẩm"></textarea>
                                    </div>
                                </div>
                            </div>
                        }
                        <div class="d-flex justify-content-between">
                            <a asp-controller="OrderHistory" asp-action="Details" asp-route-id="@Model.OrderId" class="btn btn-outline-secondary">Quay lại</a>
                            <button type="submit" class="btn btn-primary">Gửi khiếu nại</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
