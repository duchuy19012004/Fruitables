@using Fruitables.Helpers
@using Fruitables.Models
@using Fruitables.Models.Returns
@using Fruitables.ViewModels.Returns
@model ReturnSubmitViewModel
@{
    ViewData["Title"] = "Yêu cầu hỗ trợ";
    var order = (Order)ViewBag.Order;
    var eligibility = (ReturnEligibilityResult)ViewBag.Eligibility;
    var eligible = eligibility.Items.Where(x => x.Eligible).ToDictionary(x => x.OrderItemId);
    var reasonRules = (Dictionary<int, Dictionary<ReturnReasonCode, bool>>)ViewBag.ReasonRules;
    var index = 0;
}
<div class="container py-5 mt-5">
    <h1 class="mb-2">Yêu cầu hỗ trợ đơn @order.OrderNumber</h1>
    <p class="text-muted">Hạn gửi sớm nhất: @(eligibility.DeadlineAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "CSKH kiểm tra thủ công")</p>
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input asp-for="OrderId" type="hidden" />
        <input asp-for="IdempotencyKey" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        @foreach (var item in order.Items.Where(x => eligible.ContainsKey(x.Id)))
        {
            var rule = eligible[item.Id];
            <div class="card mb-3"><div class="card-body">
                <div class="form-check float-end"><input class="form-check-input item-toggle" type="checkbox" name="Items[@index].Selected" value="true" id="item-@item.Id" /><label class="form-check-label" for="item-@item.Id">Chọn</label></div>
                <h5>@item.ProductName @if (!string.IsNullOrEmpty(item.VariantName)) { <small>· @item.VariantName</small> }</h5>
                <p>Còn có thể yêu cầu: <strong>@rule.RemainingQuantity</strong> · Hạn gửi @rule.DeadlineAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") <span class="badge bg-warning text-dark evidence-badge d-none">Cần bằng chứng</span></p>
                <input type="hidden" name="Items[@index].OrderItemId" value="@item.Id" />
                <div class="row g-3">
                    <div class="col-md-2"><label class="form-label">Số lượng</label><input class="form-control" type="number" min="1" max="@rule.RemainingQuantity" name="Items[@index].Quantity" value="1" data-item-field disabled /></div>
                    <div class="col-md-4"><label class="form-label">Lý do</label><select class="form-select reason-select" name="Items[@index].Reason" data-item-field disabled>@foreach (var reason in reasonRules[item.Id].Keys) { <option value="@reason" data-evidence-required="@reasonRules[item.Id][reason].ToString().ToLowerInvariant()">@ReturnDisplay.Text(reason)</option> }</select></div>
                    <div class="col-12"><label class="form-label">Mô tả</label><textarea class="form-control" minlength="5" maxlength="1000" name="Items[@index].Description" data-item-field data-optional="true" disabled></textarea></div>
                </div>
            </div></div>
            index++;
        }
        <div class="mb-3"><label asp-for="CustomerNote" class="form-label">Ghi chú chung</label><textarea asp-for="CustomerNote" class="form-control" maxlength="2000"></textarea></div>
        <div class="mb-3"><label class="form-label">Ảnh/video bằng chứng <span id="evidenceRequiredLabel" class="text-danger d-none">(bắt buộc)</span></label><input asp-for="EvidenceFiles" class="form-control" type="file" multiple accept=".jpg,.jpeg,.png,.webp,.mp4" /><small class="text-muted">Tối đa 5 file, tổng 40 MB. Ảnh tối đa 10 MB; một MP4 tối đa 30 MB.</small></div>
        <button id="submitReturnButton" class="btn btn-primary" type="submit"><span class="submit-label">Gửi yêu cầu</span><span class="submit-loading d-none"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Đang gửi...</span></button>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.querySelector('form[action="/Return/Create"]');
            const fileInput = document.getElementById('EvidenceFiles');
            const requiredLabel = document.getElementById('evidenceRequiredLabel');
            if (!form || !fileInput) return;
            const refreshItem = card => {
                const selected = card.querySelector('.item-toggle').checked;
                card.querySelectorAll('[data-item-field]').forEach(field => {
                    field.disabled = !selected;
                    field.required = selected && field.dataset.optional !== 'true';
                });
            };
            const refresh = () => {
                let required = false;
                form.querySelectorAll('.card').forEach(card => {
                    refreshItem(card);
                    const selected = card.querySelector('.item-toggle')?.checked;
                    const option = card.querySelector('.reason-select')?.selectedOptions[0];
                    const itemRequired = selected && option?.dataset.evidenceRequired === 'true';
                    card.querySelector('.evidence-badge')?.classList.toggle('d-none', !itemRequired);
                    required ||= itemRequired;
                });
                fileInput.required = required;
                requiredLabel?.classList.toggle('d-none', !required);
            };
            form.addEventListener('change', event => {
                if (event.target.matches('.item-toggle, .reason-select')) refresh();
            });
            form.addEventListener('submit', () => {
                if (!form.checkValidity()) return;
                const button = document.getElementById('submitReturnButton');
                button.disabled = true;
                button.querySelector('.submit-label').classList.add('d-none');
                button.querySelector('.submit-loading').classList.remove('d-none');
            });
            refresh();
        })();
    </script>
}
