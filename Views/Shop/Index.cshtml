@using Fruitables.ViewModels
@using Fruitables.Services.Interfaces
@inject IComboService ComboService
@model ShopViewModel
@{
    ViewData["Title"] = "Cửa hàng";
    var comboCards = await ComboService.GetActiveComboCardsAsync();
}

<main class="shop-page">
    <section class="shop-hero">
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb shop-breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Cửa hàng</li>
                </ol>
            </nav>

            <div class="shop-hero-grid">
                <div class="shop-hero-copy">
                    <span class="shop-label">Nông sản chọn lọc mỗi ngày</span>
                    <h1>Chọn thực phẩm tươi cho bữa cơm nhà</h1>
                    <p>Rau củ và trái cây rõ nguồn gốc, giao tận nơi với thao tác đặt hàng đơn giản.</p>
                </div>

                <form asp-controller="Shop" asp-action="Index" method="get" class="shop-hero-search">
                    @if (Model.SelectedCategoryId.HasValue)
                    {
                        <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                    }
                    @if (Model.MinPrice.HasValue)
                    {
                        <input type="hidden" name="minPrice" value="@Model.MinPrice" />
                    }
                    @if (Model.MaxPrice.HasValue)
                    {
                        <input type="hidden" name="maxPrice" value="@Model.MaxPrice" />
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.SortBy))
                    {
                        <input type="hidden" name="sortBy" value="@Model.SortBy" />
                    }
                    <label for="shopSearch">Bạn đang tìm gì?</label>
                    <div class="shop-search-control">
                        <i class="fas fa-search" aria-hidden="true"></i>
                        <input id="shopSearch" type="search" name="search" data-search-suggest class="form-control" placeholder="Táo, sầu riêng, rau củ..." value="@Model.SearchTerm" />
                        <button type="submit" class="btn btn-secondary">
                            <span>Tìm sản phẩm</span>
                            <i class="fas fa-arrow-right" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span class="shop-search-hint">Tìm theo tên sản phẩm hoặc combo phù hợp với nhu cầu của bạn.</span>
                </form>
            </div>
        </div>
    </section>

    <section class="shop-shell">
        <div class="container">
            <div id="shopFilterStatus" class="shop-filter-status" role="status" aria-live="polite"></div>
            <div id="shopCatalog">
                <partial name="_ShopCatalog" model="Model" />
            </div>
        </div>
    </section>

    <partial name="_ComboSection" model="comboCards" />
</main>

@section Styles {
    <link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/shop-filter.js" asp-append-version="true"></script>
    <script>
        if (window.ecommerceHub) window.ecommerceHub.on('PriceChanged', () => window.location.reload());
    </script>
}
