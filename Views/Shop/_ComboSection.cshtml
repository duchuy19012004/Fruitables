@model IReadOnlyList<Fruitables.ViewModels.ComboCardViewModel>

@if (Model.Any())
{
    <section class="combo-section" aria-labelledby="comboSectionTitle">
        <div class="container">
            <div class="combo-section-heading">
                <div>
                    <span>Đi chợ gọn hơn</span>
                    <h2 id="comboSectionTitle">Combo chuẩn bị sẵn</h2>
                </div>
                <p>Chọn trọn bộ sản phẩm cho bữa ăn gia đình và thêm vào giỏ chỉ với một thao tác.</p>
            </div>

            <div class="combo-list">
                @foreach (var combo in Model)
                {
                    <article class="combo-card">
                        <div class="combo-media">
                            @if (!string.IsNullOrEmpty(combo.ImageUrl))
                            {
                                <img src="@combo.ImageUrl" alt="@combo.Name" loading="lazy" decoding="async" />
                            }
                            <span>Tiết kiệm @combo.Savings.ToString("N0")đ</span>
                        </div>

                        <div class="combo-content">
                            <div class="combo-intro">
                                <span class="combo-kicker">Bộ sản phẩm</span>
                                <h3>@combo.Name</h3>
                                @if (!string.IsNullOrEmpty(combo.Description))
                                {
                                    <p>@combo.Description</p>
                                }
                            </div>

                            <ul class="combo-items" aria-label="Sản phẩm trong @combo.Name">
                                @foreach (var item in combo.Items)
                                {
                                    <li>
                                        <span>
                                            <strong>@item.ProductName</strong>
                                            @if (!string.IsNullOrEmpty(item.VariantName))
                                            {
                                                <small>@item.VariantName</small>
                                            }
                                        </span>
                                        <span class="combo-item-price">
                                            <small>× @item.Quantity</small>
                                            @if (item.IsAvailable)
                                            {
                                                <strong>@((item.UnitPrice * item.Quantity).ToString("N0"))đ</strong>
                                            }
                                            else
                                            {
                                                <strong>@item.UnavailableReason</strong>
                                            }
                                        </span>
                                    </li>
                                }
                            </ul>

                            <div class="combo-purchase">
                                <div class="combo-price">
                                    <span>Giá trọn bộ</span>
                                    <strong>@combo.TotalPrice.ToString("N0")đ</strong>
                                    @if (combo.Savings > 0)
                                    {
                                        <del>@combo.OriginalPrice.ToString("N0")đ</del>
                                    }
                                </div>
                                <form asp-controller="Combo" asp-action="AddToCart" method="post" class="combo-add-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@combo.Id" />
                                    <button type="submit" class="combo-add-button">
                                        <i class="fas fa-shopping-basket" aria-hidden="true"></i>
                                        <span>Thêm cả combo</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>

    <script>
        document.querySelectorAll('.combo-add-form').forEach(form => {
            form.addEventListener('submit', () => {
                const button = form.querySelector('button[type="submit"]');
                button.disabled = true;
                button.querySelector('span').textContent = 'Đang thêm...';
                button.querySelector('i').className = 'fas fa-spinner fa-spin';
            });
        });
    </script>
}
