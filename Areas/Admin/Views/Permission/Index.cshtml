@model Dictionary<string, List<Fruitables.Models.Permission>>
@{
    ViewData["Title"] = "Quản lý quyền hạn";
    Layout = "~/Areas/Admin/Views/Shared/_AdminDashboardLayout.cshtml";

    var selectedModule = ViewBag.SelectedModule as string;
    var allModules = ViewBag.AllModules as List<string> ?? new List<string>();
    var totalCount = Model.Values.Sum(list => list.Count);
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">Quản lý quyền hạn</h4>
            <p class="text-muted mb-0">Tổng cộng <span id="totalCount">@totalCount</span> quyền hạn</p>
        </div>
        <div>
            <a href="@Url.Action("Create", "Permission", new { area = "Admin" })" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i> Tạo quyền hạn mới
            </a>
        </div>
    </div>

