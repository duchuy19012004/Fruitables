@using Fruitables.ViewModels
@using System.Text.Json
@model PriceManagementViewModel
@{
    ViewData["Title"] = "Quản lý giá";
    Layout = "~/Areas/Admin/Views/Shared/_AdminDashboardLayout.cshtml";

    string TabUrl(string tab) => Url.Action("Index", "Price", new { area = "Admin", tab })!;

    var targetsJson = JsonSerializer.Serialize(Model.ScheduleTargets,
        new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
}

@section Styles {
    <link rel="stylesheet" href="~/css/price-management.css" asp-append-version="true" />
}

<div class="container-fluid py-4 price-page">
    <div class="pp-header">
        <div>
            <h4>Quản lý giá</h4>
            <p>Bảng giá: xem và chỉnh giá đang áp dụng · Lịch giảm giá: lên lịch khuyến mãi theo thời gian.</p>
        </div>
        <button class="btn btn-primary" type="button" id="createScheduleBtn">
            <i class="fas fa-calendar-plus me-2"></i>Tạo lịch giảm giá
        </button>
    </div>

    <div id="priceUpdateBanner" class="pp-update-banner d-none" role="status">
        <i class="fas fa-sync-alt"></i>
        <span>Có cập nhật mới về giá từ nơi khác.</span>
        <button type="button" id="priceUpdateReload" class="btn btn-sm btn-primary">Tải lại</button>
        <button type="button" id="priceUpdateDismiss" class="pp-banner-dismiss" aria-label="Bỏ qua">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <div class="pp-tabs" role="tablist">
        <a role="tab"
           class="@(Model.Tab == "prices" ? "active" : "")"
           aria-selected="@(Model.Tab == "prices" ? "true" : "false")"
           href="@TabUrl("prices")">
            <i class="fas fa-tags"></i>Bảng giá
        </a>
        <a role="tab"
           class="@(Model.Tab == "schedules" ? "active" : "")"
           aria-selected="@(Model.Tab == "schedules" ? "true" : "false")"
           href="@TabUrl("schedules")">
            <i class="far fa-calendar-alt"></i>Lịch giảm giá
            <span class="pp-tab-badge">@Model.ScheduleStatusCounts.GetValueOrDefault("all")</span>
        </a>
    </div>

    @if (Model.Tab == "schedules")
    {
        @await Html.PartialAsync("_SchedulesTab", Model)
    }
    else
    {
        @await Html.PartialAsync("_PriceTableTab", Model)
    }
</div>

@await Html.PartialAsync("_ScheduleModals", Model)

@section Scripts {
    <script src="~/js/price-management.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PricePage.init({
                urls: {
                    createSchedule: '@Url.Action("CreateSchedule", "Price", new { area = "Admin" })',
                    updateSchedule: '@Url.Action("UpdateSchedule", "Price", new { area = "Admin" })',
                    cancelSchedule: '@Url.Action("CancelSchedule", "Price", new { area = "Admin" })',
                    updateBasePrice: '@Url.Action("UpdateBasePrice", "Price", new { area = "Admin" })',
                    bulkUpdate: '@Url.Action("BulkUpdate", "Price", new { area = "Admin" })'
                },
                targets: @Html.Raw(targetsJson)
            });
        });
    </script>
}
