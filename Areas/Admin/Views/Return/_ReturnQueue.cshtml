@using Fruitables.Helpers
@using Fruitables.Models.Returns
@model IReadOnlyList<ReturnRequest>
@functions {
    private static string StatusClass(ReturnRequestStatus status) => status switch
    {
        ReturnRequestStatus.Submitted or ReturnRequestStatus.AwaitingEvidence => "rt-badge-warning",
        ReturnRequestStatus.UnderReview or ReturnRequestStatus.ResolutionPending => "rt-badge-info",
        ReturnRequestStatus.Approved or ReturnRequestStatus.PartiallyApproved or ReturnRequestStatus.Resolved => "rt-badge-success",
        ReturnRequestStatus.Rejected or ReturnRequestStatus.ResolutionFailed or ReturnRequestStatus.Expired => "rt-badge-danger",
        _ => "rt-badge-neutral"
    };
}
@if (Model.Count == 0)
{
    <div class="rt-empty">
        <i class="far fa-clipboard"></i>
        <strong class="d-block mb-1">Không có yêu cầu phù hợp</strong>
        <span>Thử thay đổi bộ lọc hoặc từ khóa tìm kiếm.</span>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table rt-table">
            <thead><tr><th>Yêu cầu</th><th>Khách hàng</th><th>Lý do chính</th><th>Hạn xử lý</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                var isOverdue = item.ReviewDueAtUtc < DateTime.UtcNow && item.Status is ReturnRequestStatus.Submitted or ReturnRequestStatus.UnderReview;
                var reasons = item.Items.Select(x => x.Reason).Distinct().ToList();
                <tr>
                    <td><a class="rt-code" asp-area="Admin" asp-controller="Return" asp-action="Detail" asp-route-id="@item.Id">@item.ReturnNumber</a><div class="small text-muted mt-1">Đơn @item.Order.OrderNumber</div></td>
                    <td><div class="fw-semibold">@item.User.Name</div><div class="small text-muted">@item.User.Email</div></td>
                    <td><span>@ReturnDisplay.Text(reasons[0])</span>@if (reasons.Count > 1) { <span class="small text-muted"> +@(reasons.Count - 1) lý do</span> }</td>
                    <td><div class="rt-sla @(isOverdue ? "rt-sla-overdue" : "rt-sla-ok")">@(isOverdue ? "Quá hạn · " : "")@item.ReviewDueAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div></td>
                    <td><span class="rt-badge @StatusClass(item.Status)">@ReturnDisplay.Text(item.Status)</span></td>
                    <td class="text-end"><a class="btn btn-sm btn-rt-soft" asp-area="Admin" asp-controller="Return" asp-action="Detail" asp-route-id="@item.Id">Mở hồ sơ <i class="fas fa-arrow-right ms-1"></i></a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
