@using Fruitables.Helpers
@using Fruitables.Models.Returns
@model ReturnRequest
@{
    ViewData["Title"] = $"Yêu cầu {Model.ReturnNumber}";
    Layout = "~/Areas/Admin/Views/Shared/_AdminDashboardLayout.cshtml";
    var version = Model.RowVersion == null ? "" : Convert.ToBase64String(Model.RowVersion);
    var address = AddressSnapshotHelper.FromSnapshot(Model.Order.ShippingSnapshot);
    var isOverdue = Model.ReviewDueAtUtc < DateTime.UtcNow && Model.Status is ReturnRequestStatus.Submitted or ReturnRequestStatus.UnderReview;
    var priorApproved = ViewBag.PriorApprovedQuantities as Dictionary<int, int> ?? new Dictionary<int, int>();
}
@functions {
    private static string StatusClass(ReturnRequestStatus status) => status switch
    {
        ReturnRequestStatus.Submitted or ReturnRequestStatus.AwaitingEvidence => "rt-badge-warning",
        ReturnRequestStatus.UnderReview or ReturnRequestStatus.ResolutionPending => "rt-badge-info",
        ReturnRequestStatus.Approved or ReturnRequestStatus.PartiallyApproved or ReturnRequestStatus.Resolved => "rt-badge-success",
        ReturnRequestStatus.Rejected or ReturnRequestStatus.ResolutionFailed or ReturnRequestStatus.Expired => "rt-badge-danger",
        _ => "rt-badge-neutral"
    };
}
@section Styles { <link rel="stylesheet" href="~/css/return-admin.css" asp-append-version="true" /> }

<main class="return-admin">
    @if (TempData["Success"] != null) { <div class="alert alert-success rt-alert">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger rt-alert">@TempData["Error"]</div> }

    <header class="rt-page-header">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2"><span class="rt-badge @StatusClass(Model.Status)">@ReturnDisplay.Text(Model.Status)</span>@if (isOverdue) { <span class="rt-badge rt-badge-danger">Quá hạn xử lý</span> }</div>
            <h1 class="rt-title">@Model.ReturnNumber</h1>
            <p class="rt-subtitle">Gửi lúc @Model.SubmittedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · Hạn xử lý @Model.ReviewDueAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <a asp-action="Index" class="rt-back"><i class="fas fa-arrow-left me-2"></i>Về hàng đợi</a>
    </header>

    <section class="rt-panel rt-summary" aria-label="Thông tin tổng quan">
        <div class="rt-summary-item"><span class="rt-summary-label">Đơn hàng</span><a class="rt-summary-value rt-code" asp-area="Admin" asp-controller="Order" asp-action="Detail" asp-route-id="@Model.OrderId">@Model.Order.OrderNumber</a></div>
        <div class="rt-summary-item"><span class="rt-summary-label">Khách hàng</span><span class="rt-summary-value">@Model.User.Name<br /><small class="text-muted">@Model.User.Email</small></span></div>
        <div class="rt-summary-item"><span class="rt-summary-label">Thanh toán</span><span class="rt-summary-value">@ReturnDisplay.Text(Model.Order.PaymentMethod)<br /><small class="text-muted">@ReturnDisplay.Text(Model.Order.PaymentStatus)</small></span></div>
        <div class="rt-summary-item"><span class="rt-summary-label">Địa chỉ giao hàng</span><span class="rt-summary-value">@(address?.FullAddress ?? "Không có dữ liệu địa chỉ")</span></div>
    </section>

    <div class="rt-detail-grid">
        <div>
            <section class="rt-panel">
                <div class="rt-panel-head"><h2>Sản phẩm được khiếu nại</h2><span class="small text-muted">@Model.Items.Count sản phẩm</span></div>
                <div class="rt-panel-body">
                    @foreach (var item in Model.Items)
                    {
                        var priorQuantity = priorApproved.GetValueOrDefault(item.OrderItemId);
                        <article class="rt-item">
                            <div class="rt-item-main"><div class="rt-item-name">@item.OrderItem.ProductName</div><div class="rt-item-note"><strong>@ReturnDisplay.Text(item.Reason)</strong><br />@item.Description</div></div>
                            <div><span class="rt-data-label">Đã mua / yêu cầu</span><span class="rt-data-value">@item.OrderItem.Quantity / @item.RequestedQuantity</span><small class="d-block text-muted mt-1">Đã duyệt trước đó: @priorQuantity</small></div>
                            <div><span class="rt-data-label">Được duyệt</span><span class="rt-data-value">@item.ApprovedQuantity</span></div>
                            <div><span class="rt-data-label">Hạn mức hoàn</span><span class="rt-data-value">@item.RequestedAmount.ToString("N0")₫</span>@if (item.ApprovedAmount > 0) { <small class="d-block text-success mt-1">Duyệt @item.ApprovedAmount.ToString("N0")₫</small> }</div>
                        </article>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.DecisionReason)) { <div class="alert alert-light border mt-3 mb-0"><strong>Lý do quyết định:</strong> @Model.DecisionReason</div> }
                </div>
            </section>

            <section class="rt-panel">
                <div class="rt-panel-head"><h2>Bằng chứng</h2><span class="small text-muted">@Model.Evidences.Count tệp</span></div>
                <div class="rt-panel-body"><partial name="_EvidenceGallery" model="Model.Evidences" /></div>
            </section>

            @if (Model.Status == ReturnRequestStatus.UnderReview) { <partial name="_DecisionForm" model="Model" /> }

            @if (Model.Refunds.Count > 0)
            {
                <section class="rt-panel">
                    <div class="rt-panel-head"><h2>Lịch sử hoàn tiền</h2></div>
                    <div class="table-responsive"><table class="table rt-table"><thead><tr><th>Sản phẩm</th><th>Số tiền</th><th>Phương thức</th><th>Trạng thái</th><th>Thông tin nhận tiền</th><th>Mã giao dịch</th></tr></thead><tbody>@foreach (var refund in Model.Refunds.OrderByDescending(x => x.CreatedAtUtc)) { <tr><td>@(refund.ReturnRequestItem?.OrderItem?.ProductName ?? "Theo yêu cầu")</td><td class="fw-bold">@refund.Amount.ToString("N0")₫</td><td>@ReturnDisplay.Text(refund.Method)</td><td>@ReturnDisplay.Text(refund.Status)</td><td>@(string.IsNullOrWhiteSpace(refund.DestinationBankCode) || string.IsNullOrWhiteSpace(refund.DestinationAccountLast4) ? "Chưa có" : $"{refund.DestinationBankCode} ••••{refund.DestinationAccountLast4}")</td><td>@(refund.TransactionReference ?? "Chưa có")</td></tr> }</tbody></table></div>
                </section>
            }
        </div>

        <aside>
            @if (Model.Status == ReturnRequestStatus.Submitted)
            {
                <section class="rt-panel"><div class="rt-panel-head"><h2>Tiếp nhận yêu cầu</h2></div><div class="rt-panel-body"><form asp-action="StartReview" method="post" class="mb-3">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="rowVersion" value="@version" /><button class="btn btn-rt-primary w-100" type="submit"><i class="fas fa-search me-2"></i>Bắt đầu thẩm định</button></form><form asp-action="RequestEvidence" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="rowVersion" value="@version" /><label class="form-label">Nội dung cần bổ sung</label><textarea class="form-control mb-2" name="note" rows="3" required></textarea><button class="btn btn-rt-soft w-100" type="submit">Yêu cầu thêm bằng chứng</button></form></div></section>
            }
            else if (Model.Status is ReturnRequestStatus.ResolutionPending or ReturnRequestStatus.ResolutionFailed or ReturnRequestStatus.Resolved)
            {
                <section class="rt-panel"><div class="rt-panel-head"><h2>Trạng thái xử lý</h2></div><div class="rt-panel-body"><div class="alert alert-info mb-0" role="status">Đã chuyển sang hàng đợi Finance</div></div></section>
            }

            <section class="rt-panel"><div class="rt-panel-head"><h2>Lịch sử xử lý</h2></div><div class="rt-panel-body"><partial name="_StatusTimeline" model="Model.Events" /></div></section>
        </aside>
    </div>
</main>
