@using Fruitables.Helpers
@using Fruitables.Models.Returns
@using Fruitables.ViewModels.Returns
@model IReadOnlyList<ReturnRequest>
@{
    ViewData["Title"] = "Khiếu nại và đổi trả";
    Layout = "~/Areas/Admin/Views/Shared/_AdminDashboardLayout.cshtml";
    var filter = ViewBag.Filter as ReturnQueueFilter ?? new ReturnQueueFilter();
    var now = DateTime.UtcNow;
    var intake = Model.Count(x => x.Status == ReturnRequestStatus.Submitted);
    var waiting = Model.Count(x => x.Status == ReturnRequestStatus.AwaitingEvidence);
    var reviewing = Model.Count(x => x.Status == ReturnRequestStatus.UnderReview);
    var overdue = Model.Count(x => x.ReviewDueAtUtc < now && x.Status is ReturnRequestStatus.Submitted or ReturnRequestStatus.UnderReview);
    var completed = Model.Count(x => x.Status is ReturnRequestStatus.Rejected or ReturnRequestStatus.ResolutionPending or ReturnRequestStatus.ResolutionFailed or ReturnRequestStatus.Resolved or ReturnRequestStatus.Cancelled or ReturnRequestStatus.Expired);
}
@section Styles { <link rel="stylesheet" href="~/css/return-admin.css" asp-append-version="true" /> }

<main class="return-admin">
    <header class="rt-page-header">
        <div>
            <div class="rt-eyebrow">Trung tâm hậu mãi</div>
            <h1 class="rt-title">Khiếu nại và đổi trả</h1>
            <p class="rt-subtitle">Theo dõi thời hạn, kiểm tra bằng chứng và xử lý hoàn tiền sau giao hàng.</p>
        </div>
    </header>

    <section class="rt-stat-grid" aria-label="Tổng quan hàng đợi hiện tại">
        <div class="rt-stat"><span class="rt-stat-label">Chờ tiếp nhận</span><span class="rt-stat-value">@intake</span></div>
        <div class="rt-stat"><span class="rt-stat-label">Chờ khách bổ sung</span><span class="rt-stat-value">@waiting</span></div>
        <div class="rt-stat"><span class="rt-stat-label">Đang thẩm định</span><span class="rt-stat-value">@reviewing</span></div>
        <div class="rt-stat"><span class="rt-stat-label">Quá hạn xử lý</span><span class="rt-stat-value text-danger">@overdue</span></div>
        <div class="rt-stat"><span class="rt-stat-label">Đã có kết quả</span><span class="rt-stat-value">@completed</span></div>
    </section>

    <section class="rt-panel" aria-label="Nhóm hàng đợi CSKH">
        <div class="rt-panel-body">
            <div class="d-flex flex-wrap gap-2" role="tablist" aria-label="Nhóm hàng đợi trả hàng">
                @foreach (var bucket in new[]
                {
                    (ReturnQueueBucket.Intake, "Tiếp nhận"),
                    (ReturnQueueBucket.WaitingCustomer, "Chờ khách bổ sung"),
                    (ReturnQueueBucket.Reviewing, "Đang xem xét"),
                    (ReturnQueueBucket.Completed, "Đã chuyển Finance / hoàn tất")
                })
                {
                    var routeValues = new Dictionary<string, string?>
                    {
                        ["Bucket"] = bucket.Item1.ToString(),
                        ["Search"] = filter.Search,
                        ["Reason"] = filter.Reason?.ToString(),
                        ["FromUtc"] = filter.FromUtc?.ToString("yyyy-MM-dd"),
                        ["ToUtc"] = filter.ToUtc?.ToString("yyyy-MM-dd")
                    };
                    var active = (filter.Bucket ?? ReturnQueueBucket.Intake) == bucket.Item1;
                    <a asp-action="Index" asp-all-route-data="routeValues" class="btn @(active ? "btn-rt-primary" : "btn-rt-soft")" aria-current="@(active ? "page" : null)">@bucket.Item2</a>
                }
            </div>
        </div>
    </section>

    <form method="get" class="rt-panel rt-filter" aria-label="Bộ lọc yêu cầu">
        <input type="hidden" name="Bucket" value="@((filter.Bucket ?? ReturnQueueBucket.Intake).ToString())" />
        <div class="row g-3 align-items-end">
            <div class="col-xl-4 col-md-6">
                <label class="form-label" for="returnSearch">Tìm kiếm</label>
                <input id="returnSearch" class="form-control" name="Search" value="@filter.Search" placeholder="Mã yêu cầu, mã đơn hoặc email" />
            </div>
            <div class="col-xl-3 col-md-6">
                <label class="form-label" for="returnReason">Lý do</label>
                <select id="returnReason" class="form-select" name="Reason">
                    <option value="">Tất cả lý do</option>
                    @foreach (var reason in Enum.GetValues<ReturnReasonCode>())
                    {
                        <option value="@reason" selected="@(filter.Reason == reason ? "selected" : null)">@ReturnDisplay.Text(reason)</option>
                    }
                </select>
            </div>
            <div class="col-xl-3 col-md-6">
                <label class="form-label" for="returnFrom">Từ ngày</label>
                <input id="returnFrom" class="form-control" type="date" name="FromUtc" value="@filter.FromUtc?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-xl-3 col-md-6">
                <label class="form-label" for="returnTo">Đến ngày</label>
                <input id="returnTo" class="form-control" type="date" name="ToUtc" value="@filter.ToUtc?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-xl-2 col-md-6 d-flex gap-2">
                <button class="btn btn-rt-primary flex-grow-1" type="submit"><i class="fas fa-filter me-2"></i>Lọc</button>
                <a asp-action="Index" asp-route-Bucket="@((filter.Bucket ?? ReturnQueueBucket.Intake).ToString())" class="btn btn-outline-secondary" title="Xóa bộ lọc" aria-label="Xóa bộ lọc"><i class="fas fa-redo"></i></a>
            </div>
        </div>
    </form>

    <section class="rt-panel" aria-labelledby="queueHeading">
        <div class="rt-panel-head">
            <h2 id="queueHeading">Hàng đợi xử lý</h2>
            <span class="text-muted small">@Model.Count yêu cầu trên trang này</span>
        </div>
        <partial name="_ReturnQueue" model="Model" />
    </section>
</main>
