@using Fruitables.Helpers
@using Fruitables.Models.Returns
@model ReturnRequest
<form asp-area="Admin" asp-controller="Return" asp-action="Decide" method="post" class="rt-panel mb-3">
    @Html.AntiForgeryToken()
    <input type="hidden" name="ReturnRequestId" value="@Model.Id" />
    <input type="hidden" name="RowVersion" value="@(Model.RowVersion == null ? "" : Convert.ToBase64String(Model.RowVersion))" />
    <div class="rt-panel-head"><h2>Quyết định xử lý</h2><span class="small text-muted">Hệ thống tự tính lại hạn mức hoàn tiền</span></div>
    <div class="rt-panel-body">
        @for (var i = 0; i < Model.Items.Count; i++)
        {
            var item = Model.Items.ElementAt(i);
            <input type="hidden" name="Items[@i].ReturnRequestItemId" value="@item.Id" />
            <div class="rt-action">
                <div class="row g-3 align-items-end">
                    <div class="col-lg-5"><div class="fw-bold">@item.OrderItem.ProductName</div><div class="small text-muted mt-1">Khách yêu cầu @item.RequestedQuantity · Hạn mức @item.RequestedAmount.ToString("N0")₫</div></div>
                    <div class="col-lg-3"><label class="form-label">Số lượng được duyệt</label><input class="form-control" type="number" min="0" max="@item.RequestedQuantity" name="Items[@i].ApprovedQuantity" value="@item.RequestedQuantity" required /></div>
                    <div class="col-lg-4"><label class="form-label">Phương án xử lý</label><select class="form-select" name="Items[@i].Resolution">@foreach (var resolution in new[] { ReturnResolutionType.PartialRefund, ReturnResolutionType.FullRefund, ReturnResolutionType.Replacement, ReturnResolutionType.StoreCredit }) { <option value="@resolution">@ReturnDisplay.Text(resolution)</option> }</select></div>
                </div>
            </div>
        }
        <div class="mt-3"><label class="form-label" for="decisionReason">Lý do quyết định</label><textarea id="decisionReason" class="form-control" name="Reason" maxlength="1000" rows="3" placeholder="Bắt buộc khi duyệt một phần hoặc từ chối"></textarea></div>
        <div class="row g-3 mt-1">
            <div class="col-md-6"><div class="form-check"><input class="form-check-input" type="checkbox" name="MerchantFault" value="true" id="merchantFault" /><label class="form-check-label" for="merchantFault">Lỗi thuộc cửa hàng hoặc đơn vị vận chuyển</label></div></div>
            <div class="col-md-6"><div class="form-check"><input class="form-check-input" type="checkbox" name="ApproveShippingFee" value="true" id="shippingFee" /><label class="form-check-label" for="shippingFee">Đề xuất hoàn phí vận chuyển</label></div></div>
        </div>
        <div class="d-flex justify-content-end mt-3"><button class="btn btn-rt-primary px-4" type="submit"><i class="fas fa-check me-2"></i>Lưu quyết định</button></div>
    </div>
</form>
