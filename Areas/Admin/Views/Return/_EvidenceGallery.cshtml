@using Fruitables.Helpers
@using Fruitables.Models.Returns
@model IEnumerable<ReturnEvidence>
@{
    var files = Model.ToList();
}
@if (files.Count == 0)
{
    <div class="rt-empty py-4"><i class="far fa-images"></i><span>Khách hàng chưa tải bằng chứng.</span></div>
}
else
{
    <div class="rt-evidence-list">
    @foreach (var file in files)
    {
        <a class="rt-file" asp-area="" asp-controller="ReturnEvidence" asp-action="Download" asp-route-id="@file.Id">
            <i class="far @(file.MimeType.StartsWith("video/") ? "fa-file-video" : "fa-file-image")"></i>
            <span><strong>@file.OriginalFileName</strong><small class="d-block text-muted">@ReturnDisplay.Text(file.ScanStatus) · @((file.SizeBytes / 1024d).ToString("N0")) KB@(file.IsInternal ? " · Nội bộ" : "")</small></span>
        </a>
    }
    </div>
}
