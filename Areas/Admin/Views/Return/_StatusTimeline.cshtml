@using Fruitables.Helpers
@using Fruitables.Models.Returns
@model IEnumerable<ReturnEvent>
<ol class="rt-timeline">
@foreach (var item in Model.OrderByDescending(x => x.CreatedAtUtc))
{
    var note = item.Note == "Finance xác nhận hoàn tiền thủ công." ? "Bộ phận tài chính xác nhận hoàn tiền thủ công." : item.Note;
    <li class="rt-timeline-item">
        <span class="rt-timeline-dot" aria-hidden="true"></span>
        <div class="rt-timeline-title">@ReturnDisplay.Text(item.Type)</div>
        <time class="rt-timeline-time" datetime="@item.CreatedAtUtc.ToString("O")">@item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy · HH:mm")</time>
        @if (!string.IsNullOrWhiteSpace(note)) { <div class="rt-timeline-note">@note</div> }
    </li>
}
</ol>
