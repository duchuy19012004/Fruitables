@model Fruitables.ViewModels.ComboListViewModel
@{
    ViewData["Title"] = "Combo sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminDashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">Combo sản phẩm</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item active">Combo sản phẩm</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Report" class="btn btn-outline-primary"><i class="fas fa-chart-line me-2"></i>Báo cáo</a>
        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Thêm combo</a>
    </div>
</div>

<div class="admin-card">
    <div class="card-header">
        <i class="fas fa-box-open me-2"></i>Danh sách combo rau củ
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover admin-table mb-0">
                <thead>
                    <tr>
                        <th style="width:80px">Ảnh</th>
                        <th>Tên combo</th>
                        <th>Số sản phẩm</th>
                        <th>Tổng giá hiện tại</th>
                        <th>Trạng thái</th>
                        <th style="width:140px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="fas fa-box-open fa-2x d-block mb-2" aria-hidden="true"></i>
                                Chưa có combo sản phẩm.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Name" class="img-thumbnail" style="width:60px;height:60px;object-fit:cover" />
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>@item.Name</td>
                            <td>@item.ItemCount sản phẩm</td>
                            <td>
                                <strong>@item.TotalPrice.ToString("N0") đ</strong>
                                @if (item.Savings > 0)
                                {
                                    <small class="d-block text-muted"><span class="text-decoration-line-through">@item.OriginalPrice.ToString("N0") đ</span> · giảm @item.Savings.ToString("N0") đ</small>
                                }
                            </td>
                            <td>
                                @if (item.Status == Fruitables.Models.ComboLifecycleStatus.Draft)
                                {
                                    <span class="badge bg-secondary">Bản nháp</span>
                                }
                                else if (item.Status == Fruitables.Models.ComboLifecycleStatus.Scheduled)
                                {
                                    <span class="badge bg-info text-dark">Hẹn lịch</span>
                                }
                                else if (item.Status == Fruitables.Models.ComboLifecycleStatus.Archived)
                                {
                                    <span class="badge bg-dark">Lưu trữ</span>
                                }
                                else if (!item.IsSellable)
                                {
                                    <span class="badge bg-warning text-dark" title="Thiếu sản phẩm, giá hoặc tồn kho hợp lệ">Cần xử lý</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Đang bán</span>
                                }
                                @if (item.StartsAt.HasValue || item.EndsAt.HasValue)
                                {
                                    <small class="d-block text-muted mt-1">
                                        @(item.StartsAt?.ToLocalTime().ToString("dd/MM HH:mm") ?? "Bây giờ") – @(item.EndsAt?.ToLocalTime().ToString("dd/MM HH:mm") ?? "Không giới hạn")
                                    </small>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Sửa combo" aria-label="Sửa @item.Name">
                                    <i class="fas fa-edit" aria-hidden="true"></i>
                                </a>
                                <a asp-action="Audit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Nhật ký" aria-label="Nhật ký @item.Name">
                                    <i class="fas fa-history" aria-hidden="true"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline combo-delete-form" data-combo-name="@item.Name">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Lưu trữ combo" aria-label="Lưu trữ @item.Name" @(item.Status == Fruitables.Models.ComboLifecycleStatus.Archived ? "disabled" : null)>
                                        <i class="fas fa-ban" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.combo-delete-form').forEach(form => {
            form.addEventListener('submit', event => {
                const name = form.dataset.comboName || 'combo này';
                if (!window.confirm(`Lưu trữ "${name}"? Combo đang có trong giỏ khách sẽ yêu cầu thêm lại.`)) {
                    event.preventDefault();
                    return;
                }

                const button = form.querySelector('button[type="submit"]');
                button.disabled = true;
                button.innerHTML = '<i class="fas fa-spinner fa-spin" aria-hidden="true"></i>';
            });
        });
    </script>
}
