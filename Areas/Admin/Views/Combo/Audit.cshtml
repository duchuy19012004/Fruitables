@model Fruitables.ViewModels.ComboAuditViewModel
@{
    ViewData["Title"] = "Nhật ký combo";
    Layout = "~/Areas/Admin/Views/Shared/_AdminDashboardLayout.cshtml";
}

<div class="mb-4">
    <h4 class="mb-1">Nhật ký: @Model.ComboName</h4>
    <a asp-action="Index" class="text-decoration-none"><i class="fas fa-arrow-left me-1"></i>Danh sách combo</a>
</div>

<div class="admin-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>Thời gian</th><th>Thao tác</th><th>Revision</th><th>Người thực hiện</th><th>Chi tiết</th></tr></thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted py-5">Chưa có nhật ký cho combo này.</td></tr>
            }
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td><span class="badge bg-secondary">@item.Action</span></td>
                    <td>@item.Revision</td>
                    <td>@item.AdminName</td>
                    <td>@item.Details</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
